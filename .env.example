# Template only — NEVER put real keys in this file. It is tracked by git.
# Copy it to .env (gitignored) and put the real values there:
#
#   cp .env.example .env
#
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
ARTIFICIALANALYSIS_API_KEY=aa_REPLACE_ME

# Ceilings on Artificial Analysis requests, not targets. The free tier allows
# 100/day; 3/hour x 24 = 72, so the hourly cap keeps us under on its own and
# stops a stuck loop burning the allowance. The daily cap is the backstop.
AA_HOURLY_BUDGET=3
AA_DAILY_BUDGET=75
